<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Kinematic simulation only: no motor transport or physical dynamics. -->
  <xacro:macro name="arctos_urdf_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <xacro:macro name="mock_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions[joint_name]}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:mock_joint joint_name="joint_1"/>
      <xacro:mock_joint joint_name="joint_2"/>
      <xacro:mock_joint joint_name="joint_3"/>
      <xacro:mock_joint joint_name="joint_4"/>
      <xacro:mock_joint joint_name="joint_5"/>
      <xacro:mock_joint joint_name="joint_6"/>
      <xacro:mock_joint joint_name="jaw1"/>
      <xacro:mock_joint joint_name="jaw2"/>
    </ros2_control>
  </xacro:macro>
</robot>
